{
    "templates": [
        {
            "type": "mustache",
            "input": "/.template/template.json",
            "output": "/themes/{{plt.theme}}-{{plt.plt}}-color-theme.json",
            "views": [
                {
                    "type": "plt",
                    "section_name": null
                },
                {
                    "type": "pltmeta",
                    "section_name": "plt"
                }
            ]
        },
        {
            "type": "mustache",
            "input": "/.template/package.mustache",
            "output": "/package.json",
            "views": [
                {
                    "type": "pltmeta",
                    "section_name": "plt"
                },
                {
                    "type": "plts",
                    "section_name": "plts"
                },
                {
                    "type": "port",
                    "section_name": "port"
                }
            ]
        }
    ],
    "port": {
        "title": "Visual Studio Code",
        "url": "https://code.visualstudio.com/",
        "version": "0.0.4"
    },
    "author": {
        "name": "Crystar Z",
        "email": "crystar.z@outlook.com",
        "url": "https://github.com/CrystarZ"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/OneiroiTheme/vscode.git"
    },
    "license": "MIT",
    "blurb": "A fancy, pink-accented theme for vscode."
}